meta {
  name: Autenticar usuario
  type: http
  seq: 1
}

post {
  url: http://localhost:3000/api/v1/user/authenticate
  body: json
  auth: none
}

body:json {
  {
    "username": "satinder",
    "password": "12345"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("token", res.body.token);
  }
}
